{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xivly",
  "version": "0.8.0",
  "identifier": "cc.blanchon.xivly",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Xivly",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 27
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://arxiv.org https://export.arxiv.org https://huggingface.co https://api.semanticscholar.org https://api.openalex.org https://api.crossref.org https://doi.org https://julien-blanchon.github.io",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.education",
    "shortDescription": "Papers without distraction",
    "copyright": "Julien Blanchon",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "26.2",
      "hardenedRuntime": true
    }
  },
  "mainBinaryName": "xivly"
}
